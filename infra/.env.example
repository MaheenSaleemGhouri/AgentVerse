# infra/ — compose-level environment (datastore credentials, ports).
# Copy to infra/.env before running `docker compose up`. Per-service
# runtime config lives in each service's own .env.example instead.

POSTGRES_USER=agentverse
POSTGRES_PASSWORD=agentverse_dev_only
POSTGRES_DB=agentverse
POSTGRES_PORT=5432

REDIS_PORT=6379

WEB_PORT=3000
API_PORT=8000
WORKER_PORT=8001

# Required (Phase 1) — shared between apps/web and apps/api, passed
# through by docker-compose.yml's environment blocks (ADR-0005).
# Generate real values with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret
INTERNAL_API_SECRET=replace-with-a-real-generated-secret

# Optional — GitHub OAuth (ADR-0005). Leave blank to hide the GitHub
# button rather than ship a broken one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
