# infra/ — compose-level environment (datastore credentials, ports).
# Copy to infra/.env before running `docker compose up`. Per-service
# runtime config lives in each service's own .env.example instead.

POSTGRES_USER=agentverse
POSTGRES_PASSWORD=agentverse_dev_only
POSTGRES_DB=agentverse
POSTGRES_PORT=5432

REDIS_PORT=6379

WEB_PORT=3000
API_PORT=8000
WORKER_PORT=8001

# Required (Phase 1) — shared between apps/web and apps/api, passed
# through by docker-compose.yml's environment blocks (ADR-0005).
# Generate real values with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret
INTERNAL_API_SECRET=replace-with-a-real-generated-secret

# Optional — GitHub OAuth (ADR-0005). Leave blank to hide the GitHub
# button rather than ship a broken one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional (Phase 6 gap-closure) — one pair per oauth2 MCP catalog entry.
# Same rule as GitHub above: a provider missing either half of its pair
# is absent from the Connect flow, not a button that fails on click.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

# Required (Phase 2, ADR-0006) — apps/api's OpenAI provider adapter.
# No default: a missing key fails apps/api's startup loudly rather than
# failing on the first call to /internal/provider-test/stream.
OPENAI_API_KEY=replace-with-a-real-openai-api-key

# Required (Phase 6) — key-encryption key for third-party MCP
# credentials. Read by BOTH apps/api (which writes credentials) and
# apps/worker (which resolves them at tool-call time), so it is
# deliberately not service-prefixed: two different values would make a
# credential sealed by one service unreadable by the other.
#
# 32 raw bytes, base64-encoded. Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# There is no fallback and no development default — a hardcoded key is
# indistinguishable from no encryption and would ship (CLAUDE.md Rule 1).
# Rotating: add AGENTVERSE_CREDENTIAL_KEK_V2 and switch the active
# version; existing rows stay readable under V1 until a rewrap sweep
# moves them, so rotation is not a hard cutover.
AGENTVERSE_CREDENTIAL_KEK_V1=replace-with-a-real-generated-32-byte-base64-key
