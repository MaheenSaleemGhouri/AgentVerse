# ============================================================
# AgentVerse .gitignore
# Monorepo: apps/web (Next.js 15/React 19/TS), apps/api (FastAPI/Python),
# apps/worker (Python), packages/contracts, infra/ (Docker)
# ============================================================

# ---------- Environment files ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!infra/**/*.key.example

# ---------- Node.js / Next.js (apps/web, packages/contracts) ----------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js build outputs
.next/
out/
build/
dist/

# Next.js cache
.next/cache/

# Testing
coverage/
.nyc_output/

# Turbo / Vercel
.turbo/
.vercel

# Package manager logs & lockfile debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Generated contracts (regenerated from OpenAPI, never hand-edited/committed as build output)
packages/contracts/dist/
packages/contracts/src/**/generated.ts.bak

# ---------- Python / FastAPI (apps/api, apps/worker) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# uv / pip
uv.lock.bak
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Type checkers
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter (exploratory notebooks, not product code)
.ipynb_checkpoints/

# Alembic — keep migration versions, ignore local sqlite scratch DBs
*.sqlite3
*.db

# ---------- Docker / infra ----------
# Local override compose files (never commit developer-local overrides)
docker-compose.override.yml
docker-compose.override.yaml
*.local.yml
*.local.yaml

# Terraform / IaC state (never commit state — contains secrets/infra data)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/.terraform.lock.hcl.bak

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# ---------- Claude Code ----------
.claude/settings.local.json
.claude/plans/
.claude/projects/
.claude/tasks/
.claude/*.log

# ---------- Build artifacts (general) ----------
*.log
logs/
*.tmp
*.bak
*.orig

# ---------- Cache files (general) ----------
.cache/
.parcel-cache/
*.cache

# ---------- OS artifacts ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor artifacts ----------
*.swp
*.swo
*~
