{
  "name": "@agentverse/contracts",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Shared OpenAPI-generated TypeScript contracts for AgentVerse. Types are generated from apps/api's OpenAPI schema — never hand-edited.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/generated.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
