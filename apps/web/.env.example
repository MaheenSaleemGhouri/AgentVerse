# apps/web — environment variables
#
# Every NEXT_PUBLIC_* addition ships in the client bundle and must be
# reviewed on introduction (CLAUDE.md §10). NEXT_PUBLIC_BETTER_AUTH_URL
# below is reviewed: it's Better Auth's own base URL, already public
# (it's the browser's own origin) — no secret exposure.

# Port the Next.js server listens on inside its container (infra/docker-compose.yml).
PORT=3000

# Required (Phase 1) — Better Auth (docs/adr/0005-auth-provider-and-schema-ownership.md).
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
DATABASE_URL=postgresql://agentverse:agentverse_dev_only@localhost:5432/agentverse
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Required — apps/api's internal auth-event endpoint (ADR-0005).
API_INTERNAL_URL=http://localhost:8000
INTERNAL_API_SECRET=replace-with-a-real-generated-secret

# Optional — GitHub OAuth (ADR-0005). Login/signup pages hide the GitHub
# button when unset rather than showing a broken one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
