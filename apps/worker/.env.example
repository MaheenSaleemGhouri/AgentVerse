# apps/worker — environment variables
# All settings are declared in src/agentverse_worker/infrastructure/config.py
# (Settings, prefix AGENTVERSE_WORKER_).

AGENTVERSE_WORKER_ENVIRONMENT=development
AGENTVERSE_WORKER_LOG_LEVEL=INFO
AGENTVERSE_WORKER_HOST=0.0.0.0
AGENTVERSE_WORKER_PORT=8001

# Phase 4: same Postgres instance apps/api owns the schema of (see
# infrastructure/config.py's Settings.database_url docstring for why
# this is not a service-boundary violation).
AGENTVERSE_WORKER_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse_dev_only@localhost:5432/agentverse
# Required, no default — the Agents SDK executor is the only place this is read.
AGENTVERSE_WORKER_OPENAI_API_KEY=sk-local-placeholder-not-a-real-key

# Phase 6: key-encryption key for third-party MCP credentials.
# AGENTVERSE_CREDENTIAL_KEK_V1 — set it in the process environment, NOT here.
#
# Deliberately NOT prefixed with AGENTVERSE_WORKER_ — the identical key is
# read by apps/api (which writes credentials) and apps/worker (which
# resolves them at tool-call time). A service-prefixed name would invite
# two different values, and a credential sealed by one service would then
# be unreadable by the other.
#
# That shared name is also why it cannot live in this file: Settings is
# built with env_prefix=AGENTVERSE_WORKER_ and extra="forbid", so an
# un-prefixed key here fails startup with a confusing validation error.
# docker-compose injects it from infra/.env; for a bare-metal run, export
# it first. 32 raw bytes, base64-encoded:
#
#   export AGENTVERSE_CREDENTIAL_KEK_V1="$(python -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())')"
#
# There is no fallback and no development default: a hardcoded key is
# indistinguishable from no encryption and would ship (CLAUDE.md Rule 1).
# Startup fails loudly without this.
