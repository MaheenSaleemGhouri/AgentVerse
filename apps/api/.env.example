# apps/api — environment variables
# All settings are declared in src/agentverse_api/infrastructure/config.py
# (Settings, prefix AGENTVERSE_API_). A missing required value fails
# startup loudly — there is no `os.environ.get(..., "changeme")` fallback
# anywhere in this codebase (CLAUDE.md §10).

AGENTVERSE_API_ENVIRONMENT=development
AGENTVERSE_API_LOG_LEVEL=INFO
AGENTVERSE_API_HOST=0.0.0.0
AGENTVERSE_API_PORT=8000

# Required (Phase 1) — no default, startup fails loudly without it.
AGENTVERSE_API_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse_dev_only@localhost:5432/agentverse

# Two distinct Better Auth URLs (ADR-0005) — both "localhost:3000" for
# host-based local dev (this file), but genuinely different values under
# Docker Compose (see infra/docker-compose.yml): auth_internal_url is
# where apps/api reaches apps/web server-to-server ("http://web:3000"
# in Compose); auth_public_url must match Better Auth's own configured
# baseURL — the browser-facing origin that actually appears in every
# JWT's iss/aud claims. Conflating them breaks JWT verification.
AGENTVERSE_API_AUTH_INTERNAL_URL=http://localhost:3000
AGENTVERSE_API_AUTH_PUBLIC_URL=http://localhost:3000

# Shared secret validating server-to-server calls from apps/web's Better
# Auth hooks. Generate a real value with: openssl rand -base64 32
AGENTVERSE_API_INTERNAL_API_SECRET=replace-with-a-real-generated-secret

# Required (Phase 2, ADR-0006) — no default, startup fails loudly
# without it (CLAUDE.md Rule 1: never a silent "changeme" fallback).
AGENTVERSE_API_OPENAI_API_KEY=replace-with-a-real-openai-api-key
# Optional — override for a self-hosted/compatible endpoint or a local
# test double. Leave unset to use OpenAI's default endpoint.
# AGENTVERSE_API_OPENAI_BASE_URL=

# Phase 3 — cache, queue, rate-limit counters. Defaulted rather than
# required: Redis is never the system of record (CLAUDE.md Rule 13).
AGENTVERSE_API_REDIS_URL=redis://localhost:6379/0

# Phase 6: key-encryption key for third-party MCP credentials.
# AGENTVERSE_CREDENTIAL_KEK_V1 — set it in the process environment, NOT here.
#
# The API seals credentials with it and apps/worker opens them, so both
# services must read the identical value; it therefore carries no service
# prefix. That is also why it cannot live in this file: Settings is built
# with env_prefix=AGENTVERSE_API_ and extra="forbid", so an un-prefixed key
# here fails startup with a confusing validation error.
#
# docker-compose injects it from infra/.env; for a bare-metal run, export
# it first. 32 raw bytes, base64-encoded:
#
#   export AGENTVERSE_CREDENTIAL_KEK_V1="$(python -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())')"
#
# There is no default: a missing key fails startup loudly (CLAUDE.md Rule 1).

# Required (Phase 6 gap-closure) — this service's own browser-reachable
# origin. Every OAuth provider's registered redirect_uri is
# {AGENTVERSE_API_API_PUBLIC_URL}/api/v1/integrations/oauth/callback —
# the provider redirects the user's browser straight here, not through
# apps/web, so this must be a URL the browser can actually resolve
# (unlike AUTH_INTERNAL_URL above, which never leaves the Docker network).
AGENTVERSE_API_API_PUBLIC_URL=http://localhost:8000

# Optional, one pair per oauth2 catalog entry (Notion, Linear, Jira,
# HubSpot, Cloudflare) — register an OAuth app with each provider you
# want to support and paste its client id/secret here. A provider
# missing either half of its pair is simply absent from the "Connect"
# button's options, never a button that fails on click.
#
# AGENTVERSE_API_NOTION_OAUTH_CLIENT_ID=
# AGENTVERSE_API_NOTION_OAUTH_CLIENT_SECRET=
# AGENTVERSE_API_LINEAR_OAUTH_CLIENT_ID=
# AGENTVERSE_API_LINEAR_OAUTH_CLIENT_SECRET=
# AGENTVERSE_API_JIRA_OAUTH_CLIENT_ID=
# AGENTVERSE_API_JIRA_OAUTH_CLIENT_SECRET=
# AGENTVERSE_API_HUBSPOT_OAUTH_CLIENT_ID=
# AGENTVERSE_API_HUBSPOT_OAUTH_CLIENT_SECRET=
# AGENTVERSE_API_CLOUDFLARE_OAUTH_CLIENT_ID=
# AGENTVERSE_API_CLOUDFLARE_OAUTH_CLIENT_SECRET=

# Phase 9 — Stripe. Optional AS A PAIR: leave both unset and every
# money-moving route answers 503 with a clear message, which is the
# intended state for local development, CI and preview environments. A
# secret key WITHOUT a webhook secret counts as not configured — it
# would take payments whose outcome this service could never learn.
#
# Startup refuses a key whose mode contradicts the environment: an
# sk_test_ key with AGENTVERSE_API_ENVIRONMENT=production means
# customers complete checkout and are never charged, and an sk_live_ key
# anywhere else means a test run can move real money. Both are silent
# until money is involved, so both fail startup instead.
#
# Secrets: put real values in the environment or the secrets manager,
# never in a committed file (Rule 1).
# AGENTVERSE_API_STRIPE_SECRET_KEY=sk_test_replace-with-a-real-test-mode-key
# AGENTVERSE_API_STRIPE_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret
#
# Pinned, never "latest": inheriting the Stripe account's dashboard
# default would make this service's behaviour depend on a setting nobody
# in this repo can review. Override only alongside a deliberate upgrade.
# AGENTVERSE_API_STRIPE_API_VERSION=2025-10-29.clover
